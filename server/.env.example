# Sao chép thành .env và điền giá trị thật. TUYỆT ĐỐI không commit file .env.

# Môi trường: development | testing | production
APP_ENV=development

# Chuỗi kết nối DB. Bỏ trống = mặc định sqlite:///hrm.db (dev local).
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://hrm_user:mat-khau@db:5432/hrm

# Khóa bí mật — production BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài.
SECRET_KEY=
JWT_SECRET_KEY=

# Domain frontend được phép gọi API (nhiều domain cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173

# Thư mục lưu file upload (CV, tài liệu quy chế) — để trống = server/uploads
UPLOAD_FOLDER=
MAX_CV_SIZE_MB=5

# AI — chỉ cấu hình ở server, key không bao giờ xuống frontend
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
EMBEDDING_MODEL=

# Rate limit mặc định cho toàn API
RATELIMIT_DEFAULT=600 per hour
